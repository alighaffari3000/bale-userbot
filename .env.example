# ---------------------------------------------------------------------------
# bale-userbot — copy to .env. Never commit the real .env or the session file.
# ---------------------------------------------------------------------------

# Where the account credential (JWT) is stored.
BALE_SESSION_FILE=./data/session.bale

# Optional outbound proxy, e.g. http://127.0.0.1:8080
BALE_PROXY=

# Where app.download() puts files when no destination is given.
BALE_DOWNLOAD_DIR=./data/downloads

# Which chats handlers see.
HANDLE_PRIVATE=true
HANDLE_GROUPS=false

# Only handle messages from these sender ids (comma separated). Empty = anyone.
BALE_ALLOWED_USER_IDS=

# Drop the echo of messages this account sent itself. Keep this on.
IGNORE_SELF=true

# Handle one chat's messages one at a time, in order.
SERIALIZE_PER_CHAT=true

LOG_LEVEL=INFO
# Message bodies are personal data; off by default.
LOG_MESSAGE_TEXT=false
