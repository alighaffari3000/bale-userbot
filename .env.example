# ---------------------------------------------------------------------------
# Bale AI chatbot — copy to bale_chatbot/.env and fill in.
# NEVER commit the real .env or the session file.
# ---------------------------------------------------------------------------

# --- Gemini ---------------------------------------------------------------
# Required. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=1024

# System prompt: inline, or point at a file (SYSTEM_PROMPT_FILE wins).
SYSTEM_PROMPT=تو یک دستیار فارسی‌زبان در پیام‌رسان بله هستی. کوتاه، دقیق و محترمانه جواب بده.
# SYSTEM_PROMPT_FILE=./system_prompt.txt

# --- Bale account ---------------------------------------------------------
# Where the account JWT is stored. Keep it out of git and out of images.
BALE_SESSION_FILE=./data/session.bale
# Optional outbound proxy, e.g. http://127.0.0.1:8080
BALE_PROXY=
# Optional: only answer these Bale user ids (comma separated). Empty = everyone.
BALE_ALLOWED_USER_IDS=
# answer = plain message, reply = quoted reply
REPLY_MODE=answer
TYPING_INDICATOR=true
# Answer in groups/channels too. Off by default: an account that answers every
# group message gets reported fast.
HANDLE_GROUPS=false

# --- Conversation memory --------------------------------------------------
DB_PATH=./data/chat.db
# Exchanges (user+model pairs) replayed to the model on every turn.
MAX_HISTORY_TURNS=12
MAX_INPUT_CHARS=4000
MAX_REPLY_CHARS=3500

# --- Runtime --------------------------------------------------------------
LOG_LEVEL=INFO
# Log full message bodies. Off by default — chat content is personal data.
LOG_MESSAGE_TEXT=false
